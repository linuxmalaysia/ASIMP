+  border-radius: var(--radius);
+  padding: 15px;
+  font-size: .9rem;
+}
+#left h3, #right h3 {
+  font-family: var(--f-mono);
+  text-transform: uppercase;
+  color: var(--lab-muted);
+  border-bottom: 2px solid var(--lab-border);
+  letter-spacing: 1px;
+  margin-top: 0;
+  margin-bottom: 15px;
+  padding-bottom: 5px;
+  font-size: .7rem;
+}
+#left a, #right a {
+  color: var(--lab-text);
+  border-bottom: 1px dashed var(--lab-border);
+  padding: 8px 0;
+  text-decoration: none;
+  transition: all .2s;
+  display: block;
+}
+#left a:hover, #right a:hover {
+  color: var(--lab-purple);
+  background-color: var(--lab-bg);
+  border-bottom-style: solid;
+  padding-left: 8px;
+}
+#content {
+  background: var(--lab-surface);
+  border: 1px solid var(--lab-border);
+  border-radius: var(--radius);
+  grid-area: main;
+  padding: 35px;
+  box-shadow: 0 1px 3px #0000000d;
+}
+.content-body {
+  color: var(--lab-text);
+  margin: 0 auto;
+  font-size: 1.05rem;
+}
+.content-body h1, .content-body h2 {
+  color: var(--lab-heading);
+  border-bottom: 1px solid var(--lab-border);
+  padding-bottom: 10px;
+}
+#content section, #content .module, #content .lab-section, #content .version-block {
+  background-color: var(--lab-section-bg)!important;
+  color: var(--lab-text)!important;
+  border-color: var(--lab-border)!important;
+}
+#content .exercise, #content .lab-box, #content .cmd-item, #content .proc-card, #content .tool-card, #content .architect-card, #content .threat-card {
+  background-color: var(--lab-box-bg)!important;
+  color: var(--lab-text)!important;
+  border-color: var(--lab-border)!important;
+}
+#content .intro, #content .kit-intro, #content .guide-intro, #content .intro-box {
+  background-color: var(--lab-alert-bg)!important;
+  color: var(--lab-text)!important;
+}
+#content .question-box, #content .standards-warning, #content .rule-box, #content .warning-box, #content .requirement-alert, #content .next-steps, #content .grading-rubric {
+  background-color: var(--lab-warning-bg)!important;
+  color: var(--lab-text)!important;
+}
+#content .vulnerable-code {
+  background-color: var(--lab-vulnerable-bg)!important;
+  color: var(--lab-text)!important;
+}
+#content .secure-code {
+  background-color: var(--lab-secure-bg)!important;
+  color: var(--lab-text)!important;
+}
+#content .graduation-cta {
+  background-color: var(--lab-cta-bg)!important;
+  color: var(--lab-text)!important;
+}
+#content pre, #content code, #content .code-block, #content .terminal-block, #content .console-output, #content .code-snippet, #content .code-example {
+  background-color: var(--lab-code-bg)!important;
+  color: var(--lab-code-text)!important;
+  font-family: var(--f-mono);
+  border-radius: 6px;
+}
+#content pre {
+  padding: 15px;
+  overflow-x: auto;
+}
+#content code {
+  padding: 2px 4px;
+  font-size: 0.9em;
+}
+#footer {
+  color: var(--lab-muted);
+  text-align: center;
+  font-family: var(--f-mono);
+  grid-area: footer;
+  margin-top: 20px;
+  padding: 20px 0;
+  font-size: .75rem;
+  background-color: var(--lab-bg)!important;
+}
+.lab-footer-wrap {
+  background-color: var(--lab-bg)!important;
+  border-top: 1px solid var(--lab-border)!important;
+}
+
+/* Markdown styling additions */
+p {
+  margin: 1em 0;
+}
+ul, ol {
+  padding-left: 20px;
+}
+li {
+  margin-bottom: 8px;
+}
+
+table {
+  width: 100%;
+  border-collapse: collapse;
+  margin: 20px 0;
+}
+th, td {
+  padding: 10px;
+  border: 1px solid var(--lab-border);
+  text-align: left;
+}
+th {
+  background-color: var(--lab-primary);
+  color: #fff;
+}
+tr:nth-child(even) {
+  background-color: var(--lab-box-bg);
+}
+
+@media (max-width: 992px) {
+  #container {
+    grid-template-columns: 1fr;
+    grid-template-areas:
+      "header"
+      "main"
+      "left"
+      "right"
+      "footer";
+    gap: 0;
+    width: 100%;
+    padding: 0;
+  }
+  #top, #content, #left, #right {
+    border: none;
+    border-bottom: 1px solid var(--lab-border);
+    border-radius: 0;
+  }
+  #content {
+    padding: 20px;
+  }
+}
