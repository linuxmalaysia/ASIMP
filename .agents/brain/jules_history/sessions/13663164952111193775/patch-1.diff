+    // Theme toggle logic
+    document.addEventListener('DOMContentLoaded', () => {
+      const btnLight = document.getElementById('theme-btn-light');
+      const btnDark = document.getElementById('theme-btn-dark');
+      const btnAuto = document.getElementById('theme-btn-auto');
+
+      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateActiveButton(theme) {
+        [btnLight, btnDark, btnAuto].forEach(btn => {
+          if (btn) btn.style.background = 'none';
+        });
+        if (theme === 'light' && btnLight) {
+          btnLight.style.background = 'var(--lab-border)';
+        } else if (theme === 'dark' && btnDark) {
+          btnDark.style.background = 'var(--lab-border)';
+        } else if (theme === 'auto' && btnAuto) {
+          btnAuto.style.background = 'var(--lab-border)';
+        }
+      }
+
+      function handleSystemThemeChange(e) {
+        if (!localStorage.getItem('theme')) {
+          if (e.matches) {
+            document.documentElement.classList.add('theme-dark');
+            document.documentElement.classList.remove('theme-light');
+          } else {
+            document.documentElement.classList.add('theme-light');
+            document.documentElement.classList.remove('theme-dark');
+          }
+        }
+      }
+
+      function setTheme(theme) {
+        if (theme === 'dark') {
+          document.documentElement.classList.add('theme-dark');
+          document.documentElement.classList.remove('theme-light');
+          localStorage.setItem('theme', 'dark');
+        } else if (theme === 'light') {
+          document.documentElement.classList.add('theme-light');
+          document.documentElement.classList.remove('theme-dark');
+          localStorage.setItem('theme', 'light');
+        } else {
+          localStorage.removeItem('theme');
+          if (darkQuery.matches) {
+            document.documentElement.classList.add('theme-dark');
+            document.documentElement.classList.remove('theme-light');
+          } else {
+            document.documentElement.classList.add('theme-light');
+            document.documentElement.classList.remove('theme-dark');
+          }
+        }
+        updateActiveButton(theme);
+      }
+
+      btnLight?.addEventListener('click', () => setTheme('light'));
+      btnDark?.addEventListener('click', () => setTheme('dark'));
+      btnAuto?.addEventListener('click', () => setTheme('auto'));
+
+      // Retain matchMedia object and register a change listener for auto mode
+      if (darkQuery.addEventListener) {
+        darkQuery.addEventListener('change', handleSystemThemeChange);
+      } else if (darkQuery.addListener) {
+        darkQuery.addListener(handleSystemThemeChange);
+      }
+
+      const savedTheme = localStorage.getItem('theme') || 'auto';
+      setTheme(savedTheme);
+    });
+  </script>
