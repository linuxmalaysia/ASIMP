+        fail_msg: "docs/ansible_playbook_map.md references {{ item.item }}, but it does not exist in the repository"
+      loop: "{{ referenced_file_stat.results }}"
+      loop_control:
+        label: "{{ item.item }}"
+
+    - name: Assert the pre-remediation safety gate example uses FQCN and asserts the expected risk levels
+      ansible.builtin.assert:
+        that:
+          - "'ansible.builtin.assert:' in doc_content"
+          - "'CRITICAL_RISK' in doc_content"
+          - "'HIGH_RISK' in doc_content"
+        fail_msg: "docs/ansible_playbook_map.md pre-remediation safety gate example must use FQCN and document the CRITICAL_RISK/HIGH_RISK risk levels"
+
+    - name: Assert the document does not declare the 'layout' key more than once
+      ansible.builtin.assert:
+        that:
+          - (doc_content.split('---', 2)[1] | regex_findall('^layout:', multiline=True) | length) == 1
+        fail_msg: "docs/ansible_playbook_map.md front matter must declare the 'layout' key exactly once"
