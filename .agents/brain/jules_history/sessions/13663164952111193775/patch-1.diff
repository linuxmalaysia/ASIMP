+        fail_msg: "docs/ansible_playbook_map.md master matrix table must list an entry for {{ item }}"
+      loop: "{{ matrix_entries }}"
+      loop_control:
+        label: "{{ item }}"
+
+    - name: Assert every file referenced by name in the matrix actually exists in the repository
+      ansible.builtin.stat:
