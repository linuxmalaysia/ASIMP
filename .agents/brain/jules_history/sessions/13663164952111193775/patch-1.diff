+
+    <!-- EXCLUDE AUTOMATIC FIPS ENFORCEMENT -->
+    <xccdf:select idref="xccdf_org.ssgproject.content_rule_enable_fips_mode" selected="false"/>
+  </xccdf:Profile>
+
+  <!-- 2. Safeguarded Profile for Debian GNU/Linux (Derived from Standard Profile bound to ssg-debian12-ds.xml) -->
