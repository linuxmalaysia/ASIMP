+      - "play-localhost.yml"
+      - "playbooks/matrix_test.yml"
+      - "tests/test_*.yml"
+      - "scripts/verify_sitemap_links.py"
+    referenced_files:
+      - "play.yml"
+      - "play-localhost.yml"
+      - "playbooks/matrix_test.yml"
+      - "scripts/verify_sitemap_links.py"
+
+  tasks:
+    - name: Assert docs/ansible_playbook_map.md exists and is a regular file
+      ansible.builtin.stat:
+        path: "{{ doc_path }}"
+      register: doc_stat
+
+    - name: Fail loudly if the document is missing
+      ansible.builtin.assert:
+        that:
+          - doc_stat.stat.exists
+          - doc_stat.stat.isreg
+        fail_msg: "docs/ansible_playbook_map.md must exist as a regular file"
+
+    - name: Load raw content of docs/ansible_playbook_map.md
+      ansible.builtin.set_fact:
+        doc_content: "{{ lookup('file', doc_path) }}"
+
+    - name: Assert the document begins with a '---' front matter delimiter
+      ansible.builtin.assert:
+        that:
+          - doc_content.startswith('---')
