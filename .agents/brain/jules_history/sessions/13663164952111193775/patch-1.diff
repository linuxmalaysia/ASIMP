+
+### Step 4: Direct CLI Execution with Tailored Remediation (Part B2)
+
+```bash
+# Execute safe tailored remediation
+sudo oscap xccdf eval \
+  --tailoring-file tailoring.xml \
+  --profile xccdf_org.ssgproject.content_profile_cis_custom_safe \
+  --remediate \
+  --results /var/tmp/openscap_xccdf/cis-results-remediated.xml \
+  --report /var/tmp/openscap_xccdf/cis-report-remediated.html \
+  /usr/share/xml/scap/ssg/content/ssg-rhel8-ds.xml
+```
+
+---
+
+### Step 5: Production-Grade Declarative Ansible Playbook for Safeguarded Remediation (Part B2)
+
+Playbook: `remediate_safeguarded_security_guide.yml`.
+
+{% raw %}
+```yaml
+---
+- name: "Enterprise Safeguarded Baseline Remediation (Part B2)"
+  hosts: fleet
+  serial: 1
+  gather_facts: true
+  become: true
+
+  vars:
+    tailoring_file_src: "files/tailoring.xml"
+    tailoring_file_dest: "/etc/security/scap-tailoring.xml"
+
+  tasks:
+    - name: "1.0 Dynamically select SCAP DataStream and Safe Profile per host OS"
+      ansible.builtin.set_fact:
+        scap_datastream: >-
+          {%- if ansible_distribution | lower in ['rocky', 'almalinux', 'centos', 'redhat', 'oraclelinux', 'ol'] -%}
+          /usr/share/xml/scap/ssg/content/ssg-rhel{{ ansible_distribution_major_version }}-ds.xml
+          {%- elif ansible_distribution | lower in ['opensuse', 'sles', 'sled', 'suse'] -%}
+          /usr/share/xml/scap/ssg/content/ssg-sle15-ds.xml
+          {%- elif ansible_distribution | lower == 'ubuntu' and ansible_distribution_version in ['22.04', '24.04'] -%}
+          /usr/share/xml/scap/ssg/content/ssg-ubuntu{{ ansible_distribution_version | replace('.', '') }}-ds.xml
+          {%- elif ansible_distribution | lower == 'ubuntu' and ansible_distribution_version == '26.04' -%}
+          /usr/share/xml/scap/ssg/content/ssg-ubuntu2404-ds.xml
+          {%- elif ansible_distribution | lower == 'debian' and ansible_distribution_major_version in ['11', '12'] -%}
+          /usr/share/xml/scap/ssg/content/ssg-debian{{ ansible_distribution_major_version }}-ds.xml
+          {%- elif ansible_distribution | lower == 'debian' and ansible_distribution_major_version == '13' -%}
+          /usr/share/xml/scap/ssg/content/ssg-debian12-ds.xml
+          {%- else -%}
+          unsupported
+          {%- endif -%}
+        safe_profile: >-
+          {%- if ansible_distribution | lower == 'debian' -%}
+          xccdf_org.ssgproject.content_profile_standard_custom_safe
+          {%- else -%}
+          xccdf_org.ssgproject.content_profile_cis_custom_safe
+          {%- endif -%}
+
+    - name: "1.0b Fail if SCAP DataStream is unsupported for target host OS"
+      ansible.builtin.fail:
+        msg: "SCAP DataStream unsupported for {{ ansible_distribution }} {{ ansible_distribution_version }}"
+      when: scap_datastream == 'unsupported'
+
+    # -------------------------------------------------------------------------
+    # 1. PRE-FLIGHT SUBSYSTEM HEALTH CHECK (ENFORCING ASSERTIONS)
+    # -------------------------------------------------------------------------
+    - name: "1.1 Assert core message engine daemon is running prior to remediation"
+      ansible.builtin.command:
+        cmd: "pgrep -a dispatchd"
+      register: msg_proc
+      changed_when: false
+      failed_when: msg_proc.rc != 0
+      when: "'core-msg' in inventory_hostname"
+
+    - name: "1.2 Assert container manager is active prior to remediation"
+      ansible.builtin.command:
+        cmd: "podman ps -q"
+      register: container_proc
+      changed_when: false
+      failed_when: container_proc.rc != 0
+      when: "'svc-container' in inventory_hostname"
+
+    # -------------------------------------------------------------------------
+    # 2. DEPLOY AND VALIDATE TAILORED PROFILE
+    # -------------------------------------------------------------------------
+    - name: "2.1 Deploy verified SCAP tailoring XML"
+      ansible.builtin.copy:
+        src: "{{ tailoring_file_src }}"
+        dest: "{{ tailoring_file_dest }}"
+        mode: "0644"
+
+    - name: "2.2 Validate tailoring file structure prior to remediation"
+      ansible.builtin.command:
+        cmd: "oscap info {{ tailoring_file_dest }}"
+      register: tailoring_val
+      changed_when: false
+
+    - name: "2.3 Validate SCAP DataStream content prior to remediation"
+      ansible.builtin.command:
+        cmd: "oscap info {{ scap_datastream }}"
+      register: datastream_val
+      changed_when: false
+
+    # -------------------------------------------------------------------------
+    # 3. EXECUTE SAFE TAILORED REMEDIATION
+    # -------------------------------------------------------------------------
+    - name: "3.1 Execute OpenSCAP tailored remediation"
+      ansible.builtin.command:
+        cmd: >
+          oscap xccdf eval
+          --tailoring-file {{ tailoring_file_dest }}
+          --profile {{ safe_profile }}
+          --remediate
+          --results /var/tmp/openscap_xccdf/xccdf-results-remediated.xml
+          --report /var/tmp/openscap_xccdf/xccdf-report-remediated.html
+          {{ scap_datastream }}
+      register: rem_out
+      changed_when: true
+      failed_when: rem_out.rc not in [0, 2]
+
+    # -------------------------------------------------------------------------
+    # 4. POST-REMEDIATION INVARIANT ASSERTIONS
+    # -------------------------------------------------------------------------
+    - name: "4.1 CRITICAL ASSERTION: Verify SCTP module remains loadable"
+      ansible.builtin.command:
+        cmd: "modprobe -n -v sctp"
+      register: sctp_mod
+      changed_when: false
+      failed_when: "'install /bin/true' in sctp_mod.stdout or sctp_mod.rc != 0"
+
+    - name: "4.2 CRITICAL ASSERTION: Verify IP forward enabled on container node"
+      ansible.builtin.command:
+        cmd: "sysctl -n net.ipv4.ip_forward"
+      register: ip_fwd
+      changed_when: false
+      failed_when: ip_fwd.stdout.strip() != '1'
+      when: "'svc-container' in inventory_hostname"
+
+    # -------------------------------------------------------------------------
+    # 5. HARVEST POST-REMEDIATION SCORECARD
+    # -------------------------------------------------------------------------
+    - name: "5.1 Extract post-remediation compliance score"
+      ansible.builtin.shell: |
+        grep -oP '<score[^>]*>\K[0-9.]+' /var/tmp/openscap_xccdf/xccdf-results-remediated.xml | head -n 1
+      register: post_score
+      changed_when: false
+
+    - name: "5.2 Display Remediation Completion Report"
+      ansible.builtin.debug:
+        msg:
+          - "=================================================================="
+          - "HOST: {{ inventory_hostname }}"
+          - "STATUS: SAFEGUARDED REMEDIATION COMPLETED"
+          - "NEW COMPLIANCE SCORE: {{ post_score.stdout | default('N/A') }}%"
+          - "SUBSYSTEM HEALTH: ALL APPLICATION INVARIANTS SATISFIED"
+          - "=================================================================="
+```
+{% endraw %}
